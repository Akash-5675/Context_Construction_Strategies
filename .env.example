# Copy this file to .env and fill in your values. Never commit .env.

# NCBI Entrez email — required by PubMed API (any valid email)
ENTREZ_EMAIL=your_email@example.com

# Optional: NCBI API key for higher rate limits (300 req/s instead of 10)
# NCBI_API_KEY=your_ncbi_api_key_here

# Cloudflare Workers AI — used for all answer generation
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# Optional second Cloudflare account, to double the daily free quota
CLOUDFLARE_API_TOKEN_2=
CLOUDFLARE_ACCOUNT_ID_2=
